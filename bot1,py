    logger.info(f"  Date range (ET): {ohlcv_df.index.min()} to {ohlcv_df.index.max()}")
    logger.info(f"  Price range: ${ohlcv_df['Low'].min():.2f} to ${ohlcv_df['High'].max():.2f}")

    # Verify we're actually trading in the right hours now
    sample_times = ohlcv_df.index[::1000][:10]  # Sample 10 timestamps
    logger.info("Sample timestamps to verify ET conversion:")
    for ts in sample_times:
