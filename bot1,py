                print(f"  MARGINAL IMPROVEMENT: ML added {ml_impact['pnl_improvement']:.2f} pts value (${ml_impact['pnl_improvement'] * POINTS_VALUE * CONTRACTS_PER_TRADE:,.2f})")
        else:
            print(f"  ML DETRACTED VALUE: Lost {abs(ml_impact['pnl_improvement']):.2f} pts vs original strategy (${abs(ml_impact['pnl_improvement']) * POINTS_VALUE * CONTRACTS_PER_TRADE:,.2f})")

        print("="*70)

    def get_price_at_timestamp(self, timestamp):
        """Get price using binary search on sorted tick data - much faster"""
        if self.tick_processor:
            # Simulate 100ms execution delay
            execution_time = timestamp + timedelta(milliseconds=100)

            # Binary search for the first tick after execution time
            idx = np.searchsorted(self.tick_processor.tick_times,
                                pd.Timestamp(execution_time).to_datetime64(),
                                side='right')

            if idx < len(self.tick_processor.tick_prices):
                return float(self.tick_processor.tick_prices[idx])

        # Fallback to OHLCV
        if timestamp in self.ohlcv_df.index:
            return float(self.ohlcv_df.loc[timestamp, 'Close'])

        return None

    def create_virtual_positions_for_signal(self, entry_price, direction, segment, news_impact, timestamp):
        """Create 36 virtual positions for counterfactual analysis"""
        positions = []

        for tp in TP_SL_GRID['tp_values']:
            for sl in TP_SL_GRID['sl_values']:
                vp = VirtualPosition(
                    entry_price=entry_price,
                    tp_points=tp,
                    sl_points=sl,
                    direction=direction,
                    entry_segment=segment,
                    news_impact=news_impact,
                    entry_time=timestamp
                )
                self.virtual_positions[vp.id] = vp
                positions.append(vp)

        return positions

    def update_virtual_positions(self, current_price, timestamp):
        """Update all active virtual positions and clean up closed ones"""
        closed_positions = []

        for vp_id, vp in list(self.virtual_positions.items()):
            if vp.is_active:
                vp.check_exit(current_price, timestamp)
                if not vp.is_active:
                    self.record_virtual_outcome(vp)
                    closed_positions.append(vp_id)

        # Remove closed positions from dictionary to prevent memory bloat
        for vp_id in closed_positions:
            del self.virtual_positions[vp_id]

    def record_virtual_outcome(self, vp):
        """Record virtual position outcome for optimization"""
        segment = vp.entry_segment
        news_impact = vp.news_impact
        key = f"tp{vp.tp_points}_sl{vp.sl_points}"

        stats = self.segment_performance_2d[segment][news_impact][key]
        stats['count'] += 1

        if vp.exit_reason == 'tp_hit':
            stats['wins'] += 1
        else:
            stats['losses'] += 1

        stats['total_pnl'] += vp.pnl

        if stats['count'] > 0:
            stats['avg_pnl'] = stats['total_pnl'] / stats['count']
            prior_count = 10
            prior_mean = 0
            posterior_count = prior_count + stats['count']
            stats['expected_pnl'] = (prior_count * prior_mean + stats['count'] * stats['avg_pnl']) / posterior_count

    def get_best_params_for_context(self, segment_id, news_impact):
        """Get optimal TP/SL for given context WITH news impact multipliers applied"""
        cell_key = f"{segment_id}_{news_impact}"

        if cell_key in self.best_params_2d:
            tp, sl = self.best_params_2d[cell_key]
        else:
            # Get default values
            tp = TIME_SEGMENTS[segment_id]['default_tp'][news_impact]
            sl = TIME_SEGMENTS[segment_id]['default_sl'][news_impact]

        # Apply news impact multipliers
        tp_multiplier = NEWS_IMPACT_LEVELS[news_impact]['tp_multiplier']
        sl_multiplier = NEWS_IMPACT_LEVELS[news_impact]['sl_multiplier']

        # Adjust TP/SL based on news impact
        tp = int(tp * tp_multiplier)
        sl = int(sl * sl_multiplier)

        return tp, sl

    def optimize_parameters(self):
        """Optimize TP/SL parameters based on virtual results"""
        updates_made = 0

        for segment_id in TIME_SEGMENTS.keys():
            for news_impact in NEWS_IMPACT_LEVELS.keys():
                if segment_id not in self.segment_performance_2d:
                    continue
                if news_impact not in self.segment_performance_2d[segment_id]:
                    continue

                cell_stats = self.segment_performance_2d[segment_id][news_impact]

                best_key = None
                best_expected_pnl = float('-inf')

                for key, stats in cell_stats.items():
                    if stats['count'] >= 20:
                        if stats['expected_pnl'] > best_expected_pnl:
                            best_expected_pnl = stats['expected_pnl']
                            best_key = key

                if best_key:
                    parts = best_key.replace('tp', '').replace('sl', '').split('_')
                    new_tp = int(parts[0])
                    new_sl = int(parts[1])

                    cell_key = f"{segment_id}_{news_impact}"
                    self.best_params_2d[cell_key] = (new_tp, new_sl)
                    updates_made += 1

        if updates_made > 0:
            logger.info(f"✅ Optimized {updates_made} parameter sets")

    def run_simulation(self):
        """Run the complete simulation with FIXED chronological exit checking and session-end closure"""
        if self.ohlcv_df is None or self.ohlcv_df.empty:
            logger.error("No OHLCV data loaded!")
            return None

        if self.trades_df is None or self.trades_df.empty:
            logger.error("No tick data loaded!")
            return None

        logger.info("=" * 60)
        logger.info("Starting simulation with CHRONOLOGICAL exit checking...")
        logger.info("FIXED: No look-ahead bias - trades exit only when price hits target")
        logger.info("ENHANCED: ML vs Original Strategy Performance Comparison")
        logger.info("FIXED: Force close all trades at NY session end (4:30 PM ET)")
        logger.info(f"Position Size: {CONTRACTS_PER_TRADE} contracts per trade")
        logger.info("=" * 60)

        # Determine start index based on available data
        start_index = min(max(200, min(7200, len(self.ohlcv_df) // 4)), len(self.ohlcv_df) - 240)
        end_index = len(self.ohlcv_df) - ML_CONFIG['max_trade_duration_bars'] - 1  # -1 to account for next bar entry

        logger.info(f"Simulation configuration:")
        logger.info(f"  Total bars available: {len(self.ohlcv_df)}")
        logger.info(f"  Start index: {start_index}")
        logger.info(f"  End index: {end_index}")
        logger.info(f"  Bars to process: {end_index - start_index}")

        # Track active trades
        active_trades = []
        last_signal_bar = -float('inf')

        # Initialize date tracking
        self.current_date = None
        self.current_month = None

        # Performance tracking
        start_time = time.time()
        last_update_time = start_time

        for i in range(start_index, end_index):
            self.bars_processed += 1
            timestamp = self.ohlcv_df.index[i]

            # Update session tracker for new day
            self.session_tracker.update_on_new_day(timestamp.date())

            # Check for day/month change
            date_str = timestamp.strftime('%Y-%m-%d')
            month_str = timestamp.strftime('%Y-%m')

            # Print daily summary when day changes
            if self.current_date and date_str != self.current_date:
                self.print_daily_summary(self.current_date)

            # Print monthly summary when month changes
            if self.current_month and month_str != self.current_month:
                self.print_monthly_summary(self.current_month)

            self.current_date = date_str
            self.current_month = month_str

            # Get current price from tick data (optimized)
            current_price = self.get_price_at_timestamp(timestamp)
            if current_price is None or current_price == 0:
                continue

            # Update virtual positions
            self.update_virtual_positions(current_price, timestamp)

            # FIXED: Check if we're at NY session end (4:30 PM ET) and force close all trades
            if is_ny_session_end(timestamp):
                num_closed = self.close_all_trades_at_session_end(active_trades, timestamp, current_price)
                if num_closed > 0:
                    logger.info(f"🔔 NY Session End at {timestamp}: Force closed {num_closed} active trades")

            # Check if NY session for NEW trading
            if is_ny_session(timestamp):
                self.ny_session_bars += 1
            else:
                continue  # Skip new signal detection outside NY session

            # Get data up to current point
            candles_up_to_now = self.ohlcv_df.iloc[:i + 1]

            # FIXED: Execute pending signals from previous bar (realistic entry timing)
            if self.pending_signals:
                signals_to_execute = []
                signals_to_keep = []

                for pending_signal in self.pending_signals:
                    # Check if this signal should be executed on this bar
                    signal_bar_time = pending_signal.signal_time
                    # Entry should happen on the next bar after signal detection
                    expected_entry_time = signal_bar_time + timedelta(minutes=1)

                    if timestamp >= expected_entry_time:
                        signals_to_execute.append(pending_signal)
                    else:
                        signals_to_keep.append(pending_signal)

                # Update pending signals list
                self.pending_signals = signals_to_keep

                # Execute pending signals
                for pending_signal in signals_to_execute:
                    self.execute_pending_signal(pending_signal, active_trades, timestamp, current_price, candles_up_to_now)

            # Check for NEW signal at current bar close
            signal_data = candles_up_to_now.tail(200)
            signal = self.pinescript_strategy.calculate_signals(signal_data)

            if signal:
                self.total_signals += 1
                last_signal_bar = i

                # Get session stats for features
                session_stats = self.session_tracker.get_stats(timestamp)

                # Extract features at signal detection time
                features = self.ml_trainer.extract_features_at_entry(
                    timestamp, candles_up_to_now, current_price, session_stats
                )
                segment_id, _ = get_current_time_segment(timestamp)
                news_impact = get_news_impact_for_date(timestamp.date())

                # Create pending signal for execution on next bar
                pending_signal = PendingSignal(
                    signal=signal,
                    segment_id=segment_id,
                    news_impact=news_impact,
                    signal_time=timestamp,
                    features=features
                )

                self.pending_signals.append(pending_signal)

                logger.info(f"📍 Signal #{self.total_signals} detected at {timestamp.strftime('%Y-%m-%d %H:%M')}: "
                          f"{signal} (will execute on next bar)")

            # FIXED: Check exits for active trades CHRONOLOGICALLY - no look-ahead
            trades_to_close = []
            for trade in active_trades[:]:
                # Skip trades that haven't started yet
                if i <= trade['entry_bar_index']:
                    continue

                # Check if THIS bar triggers an exit
                if self.check_trade_exit_at_current_bar(trade, current_price, timestamp):
                    # Calculate P&L with 35 contracts
                    if trade['type'] == 'buy':
                        trade['pnl_points'] = trade['exit_price'] - trade['entry_price']
                    else:
                        trade['pnl_points'] = trade['entry_price'] - trade['exit_price']

                    trade['pnl_points'] -= 0.155  # Commission
                    trade['pnl_dollars'] = trade['pnl_points'] * POINTS_VALUE * CONTRACTS_PER_TRADE
                    trade['outcome'] = 'success' if trade['pnl_points'] > 0 else 'failure'

                    # Add to ML training data
                    self.ml_trainer.add_completed_trade(trade)

                    trades_to_close.append(trade)

            # Remove closed trades
            for closed_trade in trades_to_close:
                if closed_trade in active_trades:
                    active_trades.remove(closed_trade)
                    self.completed_trades.append(closed_trade)

                    if closed_trade.get('pnl_points') is not None:
                        self.total_pnl_points += closed_trade['pnl_points']

                        # Record the close
                        self.record_trade_close(closed_trade)

                        logger.info(f"   ✅ Trade closed: {closed_trade['exit_reason']} @ "
                                  f"{closed_trade['exit_price']:.2f} P&L: {closed_trade['pnl_points']:.2f} pts (${closed_trade['pnl_dollars']:,.2f})")

                        # Retrain ML periodically
                        if len(self.ml_trainer.training_data) >= self.ml_trainer.last_retrain_count + ML_CONFIG['retrain_every_n_trades']:
                            if self.ml_trainer.retrain():
                                self.ml_trainer.last_retrain_count = len(self.ml_trainer.training_data)
                                logger.info(f"   🤖 ML model retrained at {self.ml_trainer.last_retrain_count} trades")

                        # Optimize parameters periodically
                        if len(self.completed_trades) % 100 == 0:
                            self.optimize_parameters()

            # Progress update with performance metrics
            if i % 5000 == 0:
                current_time = time.time()
                elapsed = current_time - start_time
                bars_per_second = self.bars_processed / elapsed
                remaining_bars = end_index - i
                eta_seconds = remaining_bars / bars_per_second if bars_per_second > 0 else 0

                pct_complete = ((i - start_index) / (end_index - start_index)) * 100
                active_virtual = sum(1 for vp in self.virtual_positions.values() if vp.is_active)

                # Get current ML metrics
                comparison = self.performance_tracker.get_comparison_metrics()
                ml_improvement = comparison['ml_impact']['pnl_improvement']

                logger.info(f"Progress: {pct_complete:.1f}% | Active: {len(active_trades)} | "
                          f"Virtual: {active_virtual} | Pending: {len(self.pending_signals)} | "
                          f"Completed: {len(self.completed_trades)} | ML Boost: {ml_improvement:.1f} pts | "
                          f"Speed: {bars_per_second:.0f} bars/sec | "
                          f"ETA: {eta_seconds/60:.1f} min")

                last_update_time = current_time

        # Execute any remaining pending signals
        if self.pending_signals:
            logger.info(f"Executing {len(self.pending_signals)} remaining pending signals...")
            for pending_signal in self.pending_signals:
                final_timestamp = self.ohlcv_df.index[-1]
                final_price = self.ohlcv_df['Close'].iloc[-1]
                final_candles = self.ohlcv_df.iloc[:len(self.ohlcv_df)]
                self.execute_pending_signal(pending_signal, active_trades, final_timestamp, final_price, final_candles)

        # Print final performance stats
        total_time = time.time() - start_time
        logger.info(f"\n⚡ Simulation completed in {total_time/60:.1f} minutes")
        logger.info(f"   Processing speed: {self.bars_processed/total_time:.0f} bars/second")
        logger.info(f"   Tick processing speed: {len(self.trades_df)/total_time/1000:.1f}K ticks/second")

        # Print final day and month summaries
        if self.current_date:
            self.print_daily_summary(self.current_date)
        if self.current_month:
            self.print_monthly_summary(self.current_month)

        # Close remaining active trades
        logger.info(f"\nClosing {len(active_trades)} remaining active trades...")
        for trade in active_trades:
            # Use last available price
            if self.tick_processor:
                last_price = float(self.tick_processor.tick_prices[-1])
                trade['exit_time'] = pd.Timestamp(self.tick_processor.tick_times[-1])
            else:
                last_price = self.ohlcv_df['Close'].iloc[-1]
                trade['exit_time'] = self.ohlcv_df.index[-1]

            trade['exit_price'] = last_price
            trade['exit_reason'] = 'simulation_end'

            if trade['type'] == 'buy':
                trade['pnl_points'] = trade['exit_price'] - trade['entry_price']
            else:
                trade['pnl_points'] = trade['entry_price'] - trade['exit_price']

            trade['pnl_points'] -= 0.155
            trade['pnl_dollars'] = trade['pnl_points'] * POINTS_VALUE * CONTRACTS_PER_TRADE
            trade['outcome'] = 'success' if trade['pnl_points'] > 0 else 'failure'

            self.completed_trades.append(trade)
            self.total_pnl_points += trade['pnl_points']
            self.record_trade_close(trade)

        # Close remaining virtual positions
        for vp in list(self.virtual_positions.values()):
            if vp.is_active:
                last_price = self.ohlcv_df['Close'].iloc[-1]
                vp.close('simulation_end', last_price, self.ohlcv_df.index[-1])
                self.record_virtual_outcome(vp)

        # Clear virtual positions dictionary
        self.virtual_positions.clear()

        # Print final summary
        self.print_final_summary()

        return self.get_results()

    def execute_pending_signal(self, pending_signal, active_trades, entry_timestamp, entry_price, candles_up_to_now):
        """Execute a pending signal with proper ML processing and position management"""

        # Apply ML reversal logic if not already processed
        if not pending_signal.ml_processed:
            executed_signal = pending_signal.signal
            was_reversed = False
            ml_confidence = 0.5

            if pending_signal.features and self.ml_trainer.model:
                should_reverse, ml_confidence = self.ml_trainer.predict_reversal(pending_signal.features)
                if should_reverse:
                    executed_signal = 'sell' if pending_signal.signal == 'buy' else 'buy'
                    was_reversed = True
                    self.total_reversals += 1

            pending_signal.executed_signal = executed_signal
            pending_signal.was_reversed = was_reversed
            pending_signal.ml_confidence = ml_confidence
            pending_signal.ml_processed = True

        # Close opposite positions
        positions_closed = 0
        for trade in active_trades[:]:
            opposite_direction = False
            if pending_signal.executed_signal == 'buy' and trade['type'] == 'sell':
                opposite_direction = True
            elif pending_signal.executed_signal == 'sell' and trade['type'] == 'buy':
                opposite_direction = True

            if opposite_direction:
                trade['exit_time'] = entry_timestamp
                trade['exit_price'] = entry_price
                trade['exit_reason'] = 'opposite_signal'

                if trade['type'] == 'buy':
                    trade['pnl_points'] = trade['exit_price'] - trade['entry_price']
                else:
                    trade['pnl_points'] = trade['entry_price'] - trade['exit_price']

                trade['pnl_points'] -= 0.155
                trade['pnl_dollars'] = trade['pnl_points'] * POINTS_VALUE * CONTRACTS_PER_TRADE
                trade['outcome'] = 'success' if trade['pnl_points'] > 0 else 'failure'

                active_trades.remove(trade)
                self.completed_trades.append(trade)
                self.total_pnl_points += trade['pnl_points']

                # Record the close
                self.record_trade_close(trade)

                logger.info(f"   ⚡ Trade closed by opposite signal @ {entry_price:.2f} "
                          f"P&L: {trade['pnl_points']:.2f} pts (${trade['pnl_dollars']:,.2f})")

                self.ml_trainer.add_completed_trade(trade)
                positions_closed += 1

        # Close opposite virtual positions
        virtuals_closed = 0
        for vp_id in list(self.virtual_positions.keys()):
            vp = self.virtual_positions[vp_id]
            if vp.is_active:
                opposite_direction = False
                if pending_signal.executed_signal == 'buy' and vp.direction == 'sell':
                    opposite_direction = True
                elif pending_signal.executed_signal == 'sell' and vp.direction == 'buy':
                    opposite_direction = True

                if opposite_direction:
                    vp.exit_time = entry_timestamp
                    vp.exit_price = entry_price
                    vp.exit_reason = 'opposite_signal'
                    vp.is_active = False

                    if vp.direction == 'buy':
                        vp.pnl = vp.exit_price - vp.entry_price
                    else:
                        vp.pnl = vp.entry_price - vp.exit_price

                    vp.pnl -= 0.155
                    self.record_virtual_outcome(vp)
                    del self.virtual_positions[vp_id]
                    virtuals_closed += 1

        # Create new trade with news impact multipliers
        tp_points, sl_points = self.get_best_params_for_context(pending_signal.segment_id, pending_signal.news_impact)
        self.create_virtual_positions_for_signal(entry_price, pending_signal.executed_signal,
                                               pending_signal.segment_id, pending_signal.news_impact, entry_timestamp)

        self.trade_counter += 1
        trade_id = f"NQ1_{self.trade_counter}_{int(entry_timestamp.timestamp())}"

        news_events = get_economic_events_for_date(entry_timestamp.date())
        news_info = None
        if news_events:
            news_info = [{'type': e['type'], 'time': e['time'], 'impact': e['impact']} for e in news_events]

        new_trade = {
            'trade_id': trade_id,
            'symbol': 'NQ1!',
            'type': pending_signal.executed_signal,
            'entry_time': entry_timestamp,
            'entry_price': float(entry_price),
            'tp_price': float(entry_price + tp_points if pending_signal.executed_signal == 'buy' else entry_price - tp_points),
            'sl_price': float(entry_price - sl_points if pending_signal.executed_signal == 'buy' else entry_price + sl_points),
            'tp_points': float(tp_points),
            'sl_points': float(sl_points),
            'risk_ratio': float(tp_points / sl_points) if sl_points > 0 else 2.0,
            'features': pending_signal.features,
            'was_reversed': pending_signal.was_reversed,
            'ml_confidence': float(pending_signal.ml_confidence),
            'segment_id': pending_signal.segment_id,
            'news_impact': pending_signal.news_impact,
            'entry_bar_index': len(candles_up_to_now) - 1,
            'outcome': None,
            'exit_price': None,
            'exit_time': None,
            'exit_reason': None,
            'pnl_points': None,
            'pnl_dollars': None
        }

        active_trades.append(new_trade)
        self.total_trades += 1

        # Record the open
        self.record_trade_open(new_trade, entry_timestamp)

        logger.info(f"✅ Signal executed at {entry_timestamp.strftime('%Y-%m-%d %H:%M')}: "
                  f"{pending_signal.signal} → {pending_signal.executed_signal} @ {entry_price:.2f}" +
                  (f" (ML reversed)" if pending_signal.was_reversed else "") +
                  f" | TP/SL: {tp_points}/{sl_points}")

    def save_results_to_google_drive(self, drive_folder_id=None):
        """Save all simulation results to Google Drive in production format"""
        if not drive_folder_id:
            drive_folder_id = GOOGLE_DRIVE_FOLDER_ID

        exporter = ProductionReadyExporter(drive_folder_id)
        exporter.save_simulation_results(self)

    def get_results(self):
        """Get simulation results with ML comparison metrics and daily profitability stats"""
        comparison = self.performance_tracker.get_comparison_metrics()

        # Calculate daily profitability statistics
        daily_pnl_values = [v['pnl_dollars'] for v in self.daily_pnl.values() if v['trades_closed'] > 0]
        profitable_days = [p for p in daily_pnl_values if p > 0]
        losing_days = [p for p in daily_pnl_values if p < 0]

        num_winning_days = len(profitable_days)
        num_losing_days = len(losing_days)
        total_trading_days = len(daily_pnl_values)

        pct_profitable_days = (num_winning_days / total_trading_days * 100) if total_trading_days > 0 else 0
        avg_trade_per_day = len(self.completed_trades) / total_trading_days if total_trading_days > 0 else 0
        avg_winning_day = np.mean(profitable_days) if profitable_days else 0
        avg_losing_day = np.mean(losing_days) if losing_days else 0

        results = {
            'total_signals': self.total_signals,
            'total_trades': len(self.completed_trades),
            'total_reversals': self.total_reversals,
            'total_pnl_points': self.total_pnl_points,
            'total_pnl_dollars': self.total_pnl_points * POINTS_VALUE * CONTRACTS_PER_TRADE,
            'ml_accuracy': 0,
            'win_rate': 0,
            'optimized_params': len(self.best_params_2d),
            'completed_trades': self.completed_trades,
            'bars_processed': self.bars_processed,
            'ny_session_bars': self.ny_session_bars,
            'daily_pnl': dict(self.daily_pnl),
            'monthly_pnl': dict(self.monthly_pnl),

            # ENHANCED: Daily profitability metrics
            'daily_profitability': {
                'total_trading_days': total_trading_days,
                'winning_days': num_winning_days,
                'losing_days': num_losing_days,
                'pct_profitable_days': pct_profitable_days,
                'avg_trades_per_day': avg_trade_per_day,
                'avg_winning_day': avg_winning_day,
                'avg_losing_day': avg_losing_day,
                'best_day': max(profitable_days) if profitable_days else 0,
                'worst_day': min(losing_days) if losing_days else 0
            },

            # ENHANCED: ML vs Original comparison
            'ml_comparison': comparison
        }

        if self.completed_trades:
            wins = sum(1 for t in self.completed_trades if t['outcome'] == 'success')
            results['win_rate'] = wins / len(self.completed_trades)

            # ML accuracy
            ml_correct = sum(1 for t in self.completed_trades
                           if t.get('was_reversed') and t['outcome'] == 'success')
            ml_trades = sum(1 for t in self.completed_trades if t.get('was_reversed'))
            if ml_trades > 0:
                results['ml_accuracy'] = ml_correct / ml_trades

        return results


# === GOOGLE DRIVE INTEGRATION ===
class ProductionReadyExporter:
    """Save all artifacts to Google Drive in production format"""

    def __init__(self, folder_id):
        self.folder_id = folder_id
        self.drive_service = self.authenticate_drive()

    def authenticate_drive(self):
        """Authenticate with Google Drive"""
        try:
            creds = None

            if os.path.exists('token.json'):
                creds = Credentials.from_authorized_user_file('token.json', GOOGLE_SCOPES)

            if not creds or not creds.valid:
                if creds and creds.expired and creds.refresh_token:
                    creds.refresh(Request())
                else:
                    flow = InstalledAppFlow.from_client_secrets_file(
                        'credentials.json', GOOGLE_SCOPES)
                    creds = flow.run_local_server(port=0)

                with open('token.json', 'w') as token:
                    token.write(creds.to_json())

            service = build('drive', 'v3', credentials=creds)
            logger.info("✅ Connected to Google Drive")
            return service

        except Exception as e:
            logger.error(f"❌ Google Drive authentication failed: {e}")
            return None

    def save_file(self, filename, content):
        """Save a file to Google Drive"""
        if not self.drive_service:
            return

        try:
            media = MediaInMemoryUpload(content, mimetype='application/octet-stream')

            file_metadata = {
                'name': filename,
                'parents': [self.folder_id]
            }

            query = f"name = '{filename}' and '{self.folder_id}' in parents and trashed = false"
            results = self.drive_service.files().list(q=query, fields="files(id)").execute()
            existing_files = results.get('files', [])

            if existing_files:
                file_id = existing_files[0]['id']
                self.drive_service.files().update(fileId=file_id, media_body=media).execute()
                logger.info(f"✅ Updated {filename}")
            else:
                self.drive_service.files().create(body=file_metadata, media_body=media).execute()
                logger.info(f"✅ Created {filename}")

        except Exception as e:
            logger.error(f"Error saving {filename}: {e}")

    def save_simulation_results(self, simulator):
        """Save everything needed for live trading in production format"""
        # 1. Trained ML model
        if simulator.ml_trainer.model:
            model_data = {
                'model': simulator.ml_trainer.model,
                'scaler': simulator.ml_trainer.scaler,
                'feature_columns': simulator.ml_trainer.feature_columns,
                'confidence_threshold': simulator.ml_trainer.confidence_threshold,
                'training_data_count': len(simulator.ml_trainer.training_data)
            }
            self.save_file('NQ1_model_latest.pkl', pickle.dumps(model_data))

        # 2. Trade history - organized by date
        trades_by_date = defaultdict(list)
        for trade in simulator.completed_trades:
            date_str = trade['entry_time'].strftime('%Y%m%d')

            trade_json = trade.copy()
            trade_json['entry_time'] = trade['entry_time'].isoformat()
            if trade.get('exit_time'):
                trade_json['exit_time'] = trade['exit_time'].isoformat()

            trades_by_date[date_str].append(trade_json)

        for date_str, trades in trades_by_date.items():
            filename = f'NQ1_trade_outcomes_{date_str}.json'
            self.save_file(filename, json.dumps(trades, indent=2).encode())

        # 3. Virtual optimization data
        grid_performance_data = {}
        for segment_id in simulator.segment_performance_2d:
            if segment_id in TIME_SEGMENTS:
                grid_performance_data[segment_id] = {}
                for news_impact in simulator.segment_performance_2d[segment_id]:
                    if news_impact in NEWS_IMPACT_LEVELS:
                        grid_performance_data[segment_id][news_impact] = {}
                        for cell_key, stats in simulator.segment_performance_2d[segment_id][news_impact].items():
                            grid_performance_data[segment_id][news_impact][cell_key] = dict(stats)

        optimization_data = {
            'grid_performance_2d': grid_performance_data,
            'best_params_2d': simulator.best_params_2d,
            'grid_type': '2D',
            'exploration_rate': 0.05,
            'total_virtual_created': len(simulator.virtual_positions),
            'total_virtual_closed': sum(1 for vp in simulator.virtual_positions.values() if not vp.is_active),
            'dimensions': {
                'segments': list(TIME_SEGMENTS.keys()),
                'news_impacts': list(NEWS_IMPACT_LEVELS.keys())
            },
            'last_update': datetime.now().isoformat()
        }

        self.save_file('NQ1_virtual_optimization_2D.json',
                      json.dumps(optimization_data, indent=2, default=str).encode())

        # 4. ML Comparison Results
        comparison_data = simulator.performance_tracker.get_comparison_metrics()
        self.save_file('NQ1_ml_comparison_results.json',
                      json.dumps(comparison_data, indent=2, default=str).encode())

        # 5. Daily Profitability Statistics
        daily_stats = simulator.get_results()['daily_profitability']
        self.save_file('NQ1_daily_profitability_stats.json',
                      json.dumps(daily_stats, indent=2, default=str).encode())

        # 6. Metadata
        metadata = {
            'simulation_start': simulator.start_date.isoformat(),
            'simulation_end': simulator.end_date.isoformat(),
            'symbol': simulator.symbol,
            'contracts_per_trade': CONTRACTS_PER_TRADE,
            'total_signals': simulator.total_signals,
            'total_trades': len(simulator.completed_trades),
            'total_reversals': simulator.total_reversals,
            'total_pnl_points': simulator.total_pnl_points,
            'total_pnl_dollars': simulator.total_pnl_points * POINTS_VALUE * CONTRACTS_PER_TRADE,
            'model_trained': simulator.ml_trainer.model is not None,
            'optimized_params': len(simulator.best_params_2d),
            'ready_for_production': True,
            'last_update': datetime.now().isoformat(),
            'entry_timing_fix': 'Applied - signals detected at bar close, entries on next bar open',
            'exit_timing_fix': 'Applied - no look-ahead bias, chronological exit checking',
            'session_end_fix': 'Applied - force close all trades at NY session end (4:30 PM ET)',
            'ml_comparison': comparison_data,
            'daily_profitability': daily_stats
        }
        self.save_file('simulation_metadata.json', json.dumps(metadata, indent=2).encode())

        logger.info("✅ All simulation results saved to Google Drive")


