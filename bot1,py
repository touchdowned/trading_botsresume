    def record_trade_open(self, trade, timestamp):
        """Record when a trade is opened"""
        date_key = timestamp.strftime('%Y-%m-%d')
        month_key = timestamp.strftime('%Y-%m')

        self.daily_pnl[date_key]['trades_opened'] += 1
        self.monthly_pnl[month_key]['trades_opened'] += 1

    def record_trade_close(self, trade):
        """Record when a trade is closed and update session tracker"""
        if not trade.get('exit_time'):
            return

        date_key = trade['exit_time'].strftime('%Y-%m-%d')
        month_key = trade['exit_time'].strftime('%Y-%m')

        # Update daily stats
        daily = self.daily_pnl[date_key]
        daily['trades_closed'] += 1
        daily['pnl_points'] += trade['pnl_points']
        daily['pnl_dollars'] += trade['pnl_dollars']
        daily['closed_trades'].append(trade['trade_id'])

        if trade['pnl_points'] > 0:
            daily['wins'] += 1
        else:
            daily['losses'] += 1

        # Update monthly stats
        monthly = self.monthly_pnl[month_key]
        monthly['trades_closed'] += 1
        monthly['pnl_points'] += trade['pnl_points']
        monthly['pnl_dollars'] += trade['pnl_dollars']
        monthly['closed_trades'].append(trade['trade_id'])

        if trade['pnl_points'] > 0:
            monthly['wins'] += 1
        else:
            monthly['losses'] += 1

        # Update session tracker
        self.session_tracker.add_trade_result(trade, trade['exit_time'])

        # ENHANCED: Update performance comparison tracker
        self.performance_tracker.add_trade_result(trade)

    def check_trade_exit_at_current_bar(self, trade, current_price, current_timestamp):
        """Check if CURRENT bar triggers an exit - no look-ahead"""

        # Skip if already exited
        if trade.get('exit_time'):
            return False

        # Check if timeout (4 hours)
        elapsed_hours = (current_timestamp - trade['entry_time']).total_seconds() / 3600
        if elapsed_hours >= 4:
            trade['exit_time'] = current_timestamp
            trade['exit_price'] = current_price
            trade['exit_reason'] = 'timeout'
            return True

        # Check TP/SL hits using tick data if available, otherwise use bar close
        if self.tick_processor:
            # Get tick prices for current bar only
            tick_prices, tick_times = self.tick_processor.get_tick_prices_for_bar(current_timestamp)

            if len(tick_prices) > 0:
                # Check each tick in chronological order
                for i, tick_price in enumerate(tick_prices):
                    if trade['type'] == 'buy':
                        if tick_price >= trade['tp_price']:
                            trade['exit_time'] = current_timestamp
                            trade['exit_price'] = trade['tp_price']  # Use exact TP
                            trade['exit_reason'] = 'tp_hit'
                            return True
                        elif tick_price <= trade['sl_price']:
                            trade['exit_time'] = current_timestamp
                            trade['exit_price'] = trade['sl_price']  # Use exact SL
                            trade['exit_reason'] = 'sl_hit'
                            return True
                    else:  # sell
                        if tick_price <= trade['tp_price']:
                            trade['exit_time'] = current_timestamp
                            trade['exit_price'] = trade['tp_price']
                            trade['exit_reason'] = 'tp_hit'
                            return True
                        elif tick_price >= trade['sl_price']:
                            trade['exit_time'] = current_timestamp
                            trade['exit_price'] = trade['sl_price']
                            trade['exit_reason'] = 'sl_hit'
                            return True
            else:
                # No tick data for this bar, use close price
                current_price = current_price

        # Use bar close price if no tick data or no exit triggered by ticks
        if trade['type'] == 'buy':
            if current_price >= trade['tp_price']:
                trade['exit_time'] = current_timestamp
                trade['exit_price'] = trade['tp_price']
                trade['exit_reason'] = 'tp_hit'
                return True
            elif current_price <= trade['sl_price']:
                trade['exit_time'] = current_timestamp
                trade['exit_price'] = trade['sl_price']
                trade['exit_reason'] = 'sl_hit'
                return True
        else:  # sell
            if current_price <= trade['tp_price']:
                trade['exit_time'] = current_timestamp
                trade['exit_price'] = trade['tp_price']
                trade['exit_reason'] = 'tp_hit'
                return True
            elif current_price >= trade['sl_price']:
                trade['exit_time'] = current_timestamp
                trade['exit_price'] = trade['sl_price']
                trade['exit_reason'] = 'sl_hit'
                return True

        return False

    def close_all_trades_at_session_end(self, active_trades, timestamp, current_price):
        """Force close all active trades at NY session end (4:30 PM ET)"""
        trades_to_close = []

        for trade in active_trades[:]:
            if not trade.get('exit_time'):
                # Force close at session end
                trade['exit_time'] = timestamp
                trade['exit_price'] = current_price
                trade['exit_reason'] = 'session_end'

                # Calculate P&L with 35 contracts
                if trade['type'] == 'buy':
                    trade['pnl_points'] = trade['exit_price'] - trade['entry_price']
                else:
                    trade['pnl_points'] = trade['entry_price'] - trade['exit_price']

                trade['pnl_points'] -= 0.155  # Commission
                trade['pnl_dollars'] = trade['pnl_points'] * POINTS_VALUE * CONTRACTS_PER_TRADE
                trade['outcome'] = 'success' if trade['pnl_points'] > 0 else 'failure'

                # Add to ML training data
                self.ml_trainer.add_completed_trade(trade)

                trades_to_close.append(trade)

                logger.info(f"   📍 SESSION END: Force closed {trade['type']} trade @ {current_price:.2f} "
                          f"P&L: {trade['pnl_points']:.2f} pts (${trade['pnl_dollars']:.2f})")

        # Remove closed trades from active list and add to completed
        for closed_trade in trades_to_close:
            if closed_trade in active_trades:
                active_trades.remove(closed_trade)
                self.completed_trades.append(closed_trade)

                if closed_trade.get('pnl_points') is not None:
                    self.total_pnl_points += closed_trade['pnl_points']
                    self.record_trade_close(closed_trade)

        # Also close all virtual positions at session end
        for vp_id in list(self.virtual_positions.keys()):
            vp = self.virtual_positions[vp_id]
            if vp.is_active:
                vp.close('session_end', current_price, timestamp)
                self.record_virtual_outcome(vp)
                del self.virtual_positions[vp_id]

        return len(trades_to_close)

