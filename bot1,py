# === PERFORMANCE TRACKER CLASS ===
class PerformanceTracker:
    """Track ML vs Original strategy performance comparison"""

    def __init__(self):
        # ML Enhanced Performance
        self.ml_enhanced_pnl = 0
        self.ml_enhanced_trades = []
        self.ml_enhanced_wins = 0
        self.ml_enhanced_losses = 0

        # Original Strategy Performance (counterfactual)
        self.original_strategy_pnl = 0
        self.original_strategy_trades = []
        self.original_strategy_wins = 0
        self.original_strategy_losses = 0

        # Reversal tracking
        self.total_reversals = 0
        self.successful_reversals = 0

    def add_trade_result(self, trade):
        """Add completed trade and calculate both scenarios"""
        # Always add to ML enhanced (actual) performance
        self.ml_enhanced_pnl += trade['pnl_points']
        self.ml_enhanced_trades.append(trade)

        if trade['pnl_points'] > 0:
            self.ml_enhanced_wins += 1
        else:
            self.ml_enhanced_losses += 1

        # Calculate what would have happened with original signal
        if trade.get('was_reversed', False):
            # This trade was reversed by ML
            self.total_reversals += 1

            # Calculate original strategy outcome (opposite result)
            # If ML reversal was profitable, original would have been unprofitable
            original_pnl = -trade['pnl_points']  # Simplified assumption

            if trade['pnl_points'] > 0:  # ML reversal was successful
                self.successful_reversals += 1

        else:
            # Trade was not reversed, so original strategy would have same result
            original_pnl = trade['pnl_points']

        # Add to original strategy performance
        self.original_strategy_pnl += original_pnl

        original_trade_copy = trade.copy()
        original_trade_copy['pnl_points'] = original_pnl
        original_trade_copy['was_original'] = True
        self.original_strategy_trades.append(original_trade_copy)

        if original_pnl > 0:
            self.original_strategy_wins += 1
        else:
            self.original_strategy_losses += 1

    def get_comparison_metrics(self):
        """Get comprehensive comparison between ML and original strategy"""
        ml_total_trades = len(self.ml_enhanced_trades)
        orig_total_trades = len(self.original_strategy_trades)

        # Win rates
        ml_win_rate = self.ml_enhanced_wins / ml_total_trades if ml_total_trades > 0 else 0
        orig_win_rate = self.original_strategy_wins / orig_total_trades if orig_total_trades > 0 else 0

        # Average wins/losses
        ml_winning_trades = [t['pnl_points'] for t in self.ml_enhanced_trades if t['pnl_points'] > 0]
        ml_losing_trades = [t['pnl_points'] for t in self.ml_enhanced_trades if t['pnl_points'] <= 0]

        orig_winning_trades = [t['pnl_points'] for t in self.original_strategy_trades if t['pnl_points'] > 0]
        orig_losing_trades = [t['pnl_points'] for t in self.original_strategy_trades if t['pnl_points'] <= 0]

        ml_avg_win = np.mean(ml_winning_trades) if ml_winning_trades else 0
        ml_avg_loss = np.mean(ml_losing_trades) if ml_losing_trades else 0
        orig_avg_win = np.mean(orig_winning_trades) if orig_winning_trades else 0
        orig_avg_loss = np.mean(orig_losing_trades) if orig_losing_trades else 0

        # Performance difference
        pnl_improvement = self.ml_enhanced_pnl - self.original_strategy_pnl
        pnl_improvement_pct = (pnl_improvement / abs(self.original_strategy_pnl)) * 100 if self.original_strategy_pnl != 0 else 0

        # Reversal success rate
        reversal_success_rate = self.successful_reversals / self.total_reversals if self.total_reversals > 0 else 0
        reversal_percentage = self.total_reversals / ml_total_trades if ml_total_trades > 0 else 0

        return {
            'ml_enhanced': {
                'total_pnl': self.ml_enhanced_pnl,
                'total_trades': ml_total_trades,
                'wins': self.ml_enhanced_wins,
                'losses': self.ml_enhanced_losses,
                'win_rate': ml_win_rate,
                'avg_win': ml_avg_win,
                'avg_loss': ml_avg_loss,
                'profit_factor': abs(ml_avg_win * self.ml_enhanced_wins / (ml_avg_loss * self.ml_enhanced_losses)) if ml_avg_loss < 0 and self.ml_enhanced_losses > 0 else 0
            },
            'original_strategy': {
                'total_pnl': self.original_strategy_pnl,
                'total_trades': orig_total_trades,
                'wins': self.original_strategy_wins,
                'losses': self.original_strategy_losses,
                'win_rate': orig_win_rate,
                'avg_win': orig_avg_win,
                'avg_loss': orig_avg_loss,
                'profit_factor': abs(orig_avg_win * self.original_strategy_wins / (orig_avg_loss * self.original_strategy_losses)) if orig_avg_loss < 0 and self.original_strategy_losses > 0 else 0
            },
            'ml_impact': {
                'pnl_improvement': pnl_improvement,
                'pnl_improvement_pct': pnl_improvement_pct,
                'total_reversals': self.total_reversals,
                'successful_reversals': self.successful_reversals,
                'reversal_success_rate': reversal_success_rate,
                'reversal_percentage': reversal_percentage,
                'win_rate_improvement': ml_win_rate - orig_win_rate
            }
        }


