# === HELPER FUNCTIONS ===
def get_economic_events_for_date(date):
    """Get all economic events for a specific date"""
    date_str = date.strftime('%Y-%m-%d') if hasattr(date, 'strftime') else str(date)
    year = date_str[:4]

    events = []
    if year in ECONOMIC_CALENDAR_EXTENDED:
        for event_type, event_list in ECONOMIC_CALENDAR_EXTENDED[year].items():
            for event in event_list:
                if event['date'] == date_str:
                    event_copy = event.copy()
                    event_copy['type'] = event_type
                    events.append(event_copy)

    return events


def get_current_time_segment(timestamp=None):
    """Get the time segment for a given timestamp"""
    if timestamp is None:
        timestamp = datetime.now()

    hour = timestamp.hour
    for segment_id, segment in TIME_SEGMENTS.items():
        if hour in segment['hours']:
            return segment_id, segment
    return 'after_hours', TIME_SEGMENTS['after_hours']


def get_news_impact_for_date(date):
    """Get the highest news impact level for a specific date"""
    events = get_economic_events_for_date(date)

    if not events:
        return 'none'

    has_extreme = any(e['impact'] == 'extreme' for e in events)
    has_high = any(e['impact'] == 'high' for e in events)
    has_medium = any(e['impact'] == 'medium' for e in events)

    if has_extreme:
        return 'extreme'
    elif has_high:
        return 'high'
    elif has_medium:
        return 'medium'
    else:
        return 'none'


def is_ny_session(timestamp):
    """Check if timestamp is during NY session (6:00 AM - 4:30 PM ET)"""
    hour = timestamp.hour
    minute = timestamp.minute

    # Convert to minutes from midnight
    time_minutes = hour * 60 + minute

    # NY session: 6:00 AM (360) to 4:30 PM (990)
    return 360 <= time_minutes < 990


def is_ny_session_end(timestamp):
    """Check if timestamp is at NY session end (4:30 PM ET)"""
    hour = timestamp.hour
    minute = timestamp.minute

    # Check if it's 4:30 PM (16:30)
    return hour == 16 and minute == 30


def calculate_technical_indicators(df):
    """Calculate technical indicators for a DataFrame"""
    try:
        df = df.copy()

        # RSI
        if len(df) >= 15:
            df['RSI'] = ta.rsi(df['Close'], length=14)
            df['RSI_5'] = ta.rsi(df['Close'], length=5)
        else:
            df['RSI'] = 50
            df['RSI_5'] = 50

        # Moving averages
        if len(df) >= 20:
            df['SMA_20'] = ta.sma(df['Close'], length=20)
            df['EMA_20'] = ta.ema(df['Close'], length=20)
        else:
            df['SMA_20'] = df['Close'].mean()
            df['EMA_20'] = df['Close'].mean()

        if len(df) >= 10:
            df['EMA_10'] = ta.ema(df['Close'], length=10)
        else:
            df['EMA_10'] = df['Close'].mean()

        # MACD
        if len(df) >= 26:
            macd = ta.macd(df['Close'])
            if macd is not None:
                df['MACD'] = macd.iloc[:, 0]
                df['MACD_signal'] = macd.iloc[:, 2]
                df['MACD_hist'] = macd.iloc[:, 1]
        else:
            df['MACD'] = 0
            df['MACD_signal'] = 0
            df['MACD_hist'] = 0

        # Bollinger Bands
        if len(df) >= 20:
            bbands = ta.bbands(df['Close'])
            if bbands is not None:
                df['BB_upper'] = bbands.iloc[:, 0]
                df['BB_middle'] = bbands.iloc[:, 1]
                df['BB_lower'] = bbands.iloc[:, 2]
                df['BB_width'] = df['BB_upper'] - df['BB_lower']
                df['BB_position'] = (df['Close'] - df['BB_lower']) / (df['BB_width'] + 0.0001)
        else:
            df['BB_position'] = 0.5

        # ATR
        if len(df) >= 15:
            df['ATR'] = ta.atr(df['High'], df['Low'], df['Close'], length=14)
        else:
            df['ATR'] = (df['High'] - df['Low']).mean()

        # Volume
        if len(df) >= 20:
            df['Volume_SMA'] = df['Volume'].rolling(window=20).mean()
        else:
            df['Volume_SMA'] = df['Volume'].mean()
        df['Volume_Ratio'] = df['Volume'] / (df['Volume_SMA'] + 1)

        df.ffill(inplace=True)
        df.fillna(0, inplace=True)

        return df

    except Exception as e:
        logger.error(f"Error calculating indicators: {e}")
        return df


# === OPTIMIZED TICK PROCESSOR ===
class OptimizedTickProcessor:
    """Tick processor for price retrieval - no longer used for exit detection to avoid look-ahead"""

    def __init__(self, trades_df):
        """Initialize with pre-computed numpy arrays for fastest access"""
        logger.info(f"Initializing tick processor for {len(trades_df):,} ticks...")
        self.trades_df = trades_df

        # Convert to numpy arrays for maximum speed
        self.tick_times = trades_df.index.values
        self.tick_prices = trades_df['price'].values

        # Pre-compute time bounds for binary search optimization
        self.min_time = self.tick_times[0]
        self.max_time = self.tick_times[-1]

        logger.info("✅ Tick processor initialized")

    def get_tick_prices_for_bar(self, bar_timestamp):
        """Get all tick prices within a specific 1-minute bar (no look-ahead)"""
        bar_start = pd.Timestamp(bar_timestamp).to_datetime64()
        bar_end = pd.Timestamp(bar_timestamp + pd.Timedelta(minutes=1)).to_datetime64()

        # Get indices for this bar only
        start_idx = np.searchsorted(self.tick_times, bar_start, side='left')
        end_idx = np.searchsorted(self.tick_times, bar_end, side='left')

        if start_idx < end_idx:
            return self.tick_prices[start_idx:end_idx], self.tick_times[start_idx:end_idx]
        return np.array([]), np.array([])


