def load_aligned_historical_data(start_date, end_date, symbol='NQ'):
    """Load trades and generate OHLCV from tick data with proper UTC to ET conversion"""
    import databento as db
    import glob
    from pathlib import Path
    import pytz

    TRADES_DIR = r'C:\Users\This0\Downloads\NQ_Tick_Data_1Year_Test\GLBX-20260127-XHQG48BG4J"'

    logger.info(f"Loading historical data from DBN files:")
    logger.info(f"  Trades directory: {TRADES_DIR}")
    logger.info(f"  Simulation period: {start_date.strftime('%Y-%m-%d')} to {end_date.strftime('%Y-%m-%d')}")

    # === LOAD TRADES DATA ===
    trades_files = glob.glob(f'{TRADES_DIR}/*.trades.dbn*')
    trades_files.sort()

    # Check actual date range available
    available_dates = []
    for file in trades_files:
        try:
            filename = Path(file).name
            date_str = filename.split('-')[2].split('.')[0]
            file_date = datetime.strptime(date_str, '%Y%m%d')
            available_dates.append(file_date)
        except:
            pass

    if available_dates:
        logger.info(
            f"Available data range: {min(available_dates).strftime('%Y-%m-%d')} to {max(available_dates).strftime('%Y-%m-%d')}")

    all_trades = []

    for file_path in trades_files:
        try:
            filename = Path(file_path).name
            date_str = filename.split('-')[2].split('.')[0]
            file_date = datetime.strptime(date_str, '%Y%m%d')

            # Skip files outside date range
            if file_date < start_date or file_date > end_date:
                continue

            logger.info(f"Loading trades from: {filename}")

            store = db.DBNStore.from_file(file_path)
            df = store.to_df(map_symbols=False)

            if 'ts_event' in df.columns:
                df['timestamp'] = pd.to_datetime(df['ts_event'], unit='ns')
            else:
                df['timestamp'] = pd.to_datetime(df.index, unit='ns')

            # PRICE FILTER: Remove clearly bad prices
            # NQ futures should be between 5000 and 25000 (reasonable range)
            price_mask = (df['price'] >= 5000) & (df['price'] <= 30000)
            bad_price_count = (~price_mask).sum()
            if bad_price_count > 0:
                logger.warning(f"  Filtered {bad_price_count} trades with unreasonable prices")
                df = df[price_mask]

            trades_data = pd.DataFrame({
                'timestamp': df['timestamp'],
                'price': df['price'],  # Already scaled correctly
                'size': df['size'] if 'size' in df.columns else 1,
                'symbol': 'NQ1!'
            })

            trades_data.set_index('timestamp', inplace=True)
            all_trades.append(trades_data)

        except Exception as e:
            logger.warning(f"Error loading {file_path}: {e}")
            continue

    if all_trades:
        trades_df = pd.concat(all_trades)
        trades_df.sort_index(inplace=True)
        trades_df = trades_df[~trades_df.index.duplicated(keep='first')]

        # CRITICAL TIMEZONE CONVERSION - UTC to ET
        if trades_df.index.tz is not None:
            # If already timezone-aware, convert to ET
            trades_df.index = trades_df.index.tz_convert('America/New_York')
            logger.info("✅ Converted timezone-aware UTC timestamps to ET")
        else:
            # If timezone-naive, assume UTC and convert to ET
            trades_df.index = pd.to_datetime(trades_df.index).tz_localize('UTC').tz_convert('America/New_York')
            logger.info("✅ Localized UTC timestamps and converted to ET")

        # Now make timezone-naive for consistency with rest of code
        trades_df.index = trades_df.index.tz_localize(None)

        logger.info(f"✅ Loaded {len(trades_df):,} total trade records for NQ1!")
        logger.info(f"  Price range: ${trades_df['price'].min():.2f} to ${trades_df['price'].max():.2f}")
        logger.info(f"  Time range (ET): {trades_df.index.min()} to {trades_df.index.max()}")
    else:
        trades_df = pd.DataFrame()
        logger.warning("⚠️ No trades data loaded")
        return trades_df, pd.DataFrame()

    # === GENERATE OHLCV FROM TICK DATA ===
    logger.info("Generating OHLCV bars from tick data (timestamps now in ET)...")

    # Add buffer for indicators
    buffer_days = ML_CONFIG['buffer_calendar_days']
    adjusted_start = start_date - timedelta(days=buffer_days)

    # Filter trades to include buffer period (now comparing ET times)
    trades_for_ohlcv = trades_df[(trades_df.index >= adjusted_start) &
                                 (trades_df.index <= end_date)]

    # Generate OHLCV bars (now from ET timestamps)
    ohlcv_df = trades_for_ohlcv['price'].resample('1min').ohlc()
    ohlcv_df.columns = ['Open', 'High', 'Low', 'Close']
    ohlcv_df['Volume'] = trades_for_ohlcv['size'].resample('1min').sum()

    # Forward fill gaps
    ohlcv_df = ohlcv_df.fillna(method='ffill')
    ohlcv_df = ohlcv_df.fillna(method='bfill')

    # Add symbol column
    ohlcv_df['symbol'] = 'NQ1!'

    # Remove any remaining NaN rows
    ohlcv_df = ohlcv_df.dropna()

