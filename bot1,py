    return trades_df, ohlcv_df

# === PINESCRIPT STRATEGY ===
class PineScriptStrategy:
    """Python implementation of contrarian NY session strategy"""

    def __init__(self):
        self.ma_fast_len = 9
        self.ma_slow_len = 21
        self.rsi_len = 14
        self.min_signals = 3

    def calculate_signals(self, df):
        """Calculate contrarian signals based on PineScript logic"""
        # Check minimum data requirements
        if len(df) < max(self.ma_slow_len, self.rsi_len, 26):  # Need 26 for MACD
            return None

        # Work on a copy to avoid side effects
        df = df.copy()

        # Remove duplicates if present
        if df.index.duplicated().any():
            df = df[~df.index.duplicated(keep='last')]

        # Technical indicators
        try:
            df['MA_fast'] = df['Close'].rolling(self.ma_fast_len).mean()
            df['MA_slow'] = df['Close'].rolling(self.ma_slow_len).mean()
            df['RSI'] = ta.rsi(df['Close'], self.rsi_len)

            # MACD with error handling
            macd = ta.macd(df['Close'], 12, 26, 9)
            if macd is not None and not macd.empty:
                df['MACD_line'] = macd.iloc[:, 0]
                df['MACD_signal'] = macd.iloc[:, 2]
            else:
                df['MACD_line'] = 0
                df['MACD_signal'] = 0

            # Bollinger Bands with error handling
            bb = ta.bbands(df['Close'], 20, 2)
            if bb is not None and not bb.empty:
                df['BB_upper'] = bb.iloc[:, 0]
                df['BB_middle'] = bb.iloc[:, 1]
                df['BB_lower'] = bb.iloc[:, 2]
            else:
                # Set defaults if BB fails
                df['BB_upper'] = df['Close'] * 1.02
                df['BB_middle'] = df['Close']
                df['BB_lower'] = df['Close'] * 0.98

        except Exception as e:
            logger.warning(f"Indicator calculation failed: {e}")
            return None

        # Check we have enough data for comparisons
        if len(df) < 3:
            return None

        # Count bullish/bearish signals
        signal_count_bullish = 0
        signal_count_bearish = 0

        latest = df.iloc[-1]
        prev1 = df.iloc[-2]
        prev2 = df.iloc[-3]

        # Signal 1: MA Trend
        if latest['Close'] > latest['MA_fast'] > latest['MA_slow']:
            signal_count_bullish += 1
        elif latest['Close'] < latest['MA_fast'] < latest['MA_slow']:
            signal_count_bearish += 1

        # Signal 2: RSI Momentum (with safe access)
        if latest['RSI'] is not None and prev1['RSI'] is not None:
            if 50 < latest['RSI'] < 70 and latest['RSI'] > prev1['RSI']:
                signal_count_bullish += 1
            elif 30 < latest['RSI'] < 50 and latest['RSI'] < prev1['RSI']:
                signal_count_bearish += 1

        # Signal 3: MACD Momentum
        if latest['MACD_line'] != 0 and latest['MACD_signal'] != 0:  # Check if MACD calculated
            if latest['MACD_line'] > latest['MACD_signal'] and latest['MACD_line'] > prev1['MACD_line']:
                signal_count_bullish += 1
            elif latest['MACD_line'] < latest['MACD_signal'] and latest['MACD_line'] < prev1['MACD_line']:
                signal_count_bearish += 1

        # Signal 4: Price vs Bollinger Bands (all columns checked)
        if all(col in df.columns for col in ['BB_upper', 'BB_middle', 'BB_lower']):
            if latest['BB_middle'] < latest['Close'] < latest['BB_upper']:
                signal_count_bullish += 1
            elif latest['BB_lower'] < latest['Close'] < latest['BB_middle']:
                signal_count_bearish += 1

        # Signal 5: Candle Patterns
        is_green = latest['Close'] > latest['Open']
        is_red = latest['Close'] < latest['Open']
        prev_is_green = prev1['Close'] > prev1['Open']
        prev_is_red = prev1['Close'] < prev1['Open']

        # Bullish engulfing
        if is_green and prev_is_red and latest['Close'] > prev1['Open']:
            signal_count_bullish += 1
        # Bearish engulfing
        elif is_red and prev_is_green and latest['Close'] < prev1['Open']:
            signal_count_bearish += 1

        # Signal 6: Price Action Momentum
        consecutive_up = latest['Close'] > prev1['Close'] > prev2['Close']
        consecutive_down = latest['Close'] < prev1['Close'] < prev2['Close']

        if consecutive_up:
            signal_count_bullish += 1
        elif consecutive_down:
            signal_count_bearish += 1

        # Contrarian logic (VERIFY THIS IS INTENDED)
        if signal_count_bullish >= self.min_signals:
            return 'sell'  # Contrarian: Predict green → SELL
        elif signal_count_bearish >= self.min_signals:
            return 'buy'  # Contrarian: Predict red → BUY

        return None


# === VIRTUAL POSITION ===
class VirtualPosition:
    """Represents a single virtual position for counterfactual tracking"""

    def __init__(self, entry_price, tp_points, sl_points, direction, entry_segment, news_impact, entry_time):
        self.id = str(uuid.uuid4())
        self.entry_price = entry_price
        self.tp_points = tp_points
        self.sl_points = sl_points
        self.direction = direction
        self.entry_segment = entry_segment
        self.news_impact = news_impact
        self.entry_time = entry_time
        self.exit_time = None
        self.exit_price = None
        self.exit_reason = None
        self.pnl = None
        self.is_active = True

        # Calculate TP/SL prices
        if direction == 'buy':
            self.tp_price = entry_price + tp_points
            self.sl_price = entry_price - sl_points
        else:
            self.tp_price = entry_price - tp_points
            self.sl_price = entry_price + sl_points

    def check_exit(self, current_price, timestamp):
        """Check if position should exit"""
        if not self.is_active:
            return

        # Check TP/SL
        if self.direction == 'buy':
            if current_price >= self.tp_price:
                self.close('tp_hit', current_price, timestamp)
            elif current_price <= self.sl_price:
                self.close('sl_hit', current_price, timestamp)
        else:
            if current_price <= self.tp_price:
                self.close('tp_hit', current_price, timestamp)
            elif current_price >= self.sl_price:
                self.close('sl_hit', current_price, timestamp)

        # Check timeout (4 hours)
        if self.is_active:
            elapsed_hours = (timestamp - self.entry_time).total_seconds() / 3600
            if elapsed_hours >= 4:
                self.close('timeout', current_price, timestamp)

    def close(self, reason, exit_price, timestamp):
        """Close the virtual position"""
        if not self.is_active:
            return

        self.is_active = False
        self.exit_time = timestamp
        self.exit_price = exit_price
        self.exit_reason = reason

        # Calculate P&L
        if self.direction == 'buy':
            self.pnl = exit_price - self.entry_price
        else:
            self.pnl = self.entry_price - exit_price

        # Subtract commission
        self.pnl -= 0.155


# === ML MODEL ===
class HistoricalMLTrainer:
    """ML model for historical simulation with proper session tracking"""

    def __init__(self):
        self.training_data = []
        self.model = None
        self.scaler = StandardScaler()
        self.feature_columns = []
        self.retrain_interval = 300
        self.confidence_threshold = 0.65
        self.last_retrain_count = 0

        # Session tracking for features
        self.session_tracker = SessionTracker()

    def extract_features_at_entry(self, entry_time, candles_df, price, session_stats):
        """Extract features at trade entry time with all features properly calculated"""
        features = {}

        # Get candles up to entry time
        available_candles = candles_df[candles_df.index <= entry_time]

        if len(available_candles) < 20:
            return None

        # Use last 200 bars for indicators
        indicator_data = available_candles.tail(200)
        df = calculate_technical_indicators(indicator_data)
        latest = df.iloc[-1]

        # Technical features - exact format from production
        features['RSI'] = float(latest.get('RSI', 50))
        features['RSI_5'] = float(latest.get('RSI_5', 50))
        features['MACD'] = float(latest.get('MACD', 0))
        features['MACD_hist'] = float(latest.get('MACD_hist', 0))
        features['BB_position'] = float(latest.get('BB_position', 0.5))
        features['Volume_Ratio'] = float(latest.get('Volume_Ratio', 1))
        features['ATR'] = float(latest.get('ATR', 1))
        features['hour'] = entry_time.hour
        features['day_of_week'] = entry_time.weekday()

        # Session features
        if entry_time.hour >= 18:
            session_start = entry_time.replace(hour=18, minute=0, second=0, microsecond=0)
        else:
            session_start = (entry_time - timedelta(days=1)).replace(hour=18, minute=0, second=0, microsecond=0)

        session_data = available_candles[available_candles.index >= session_start]

        if len(session_data) > 0:
            session_high = session_data['High'].max()
            session_low = session_data['Low'].min()

            # Find bars since high/low
            high_idx = session_data['High'].idxmax()
            low_idx = session_data['Low'].idxmin()

            try:
                features['bars_since_session_high'] = len(session_data) - session_data.index.get_loc(high_idx)
                features['bars_since_session_low'] = len(session_data) - session_data.index.get_loc(low_idx)
            except:
                features['bars_since_session_high'] = 0
                features['bars_since_session_low'] = 0

            features['percent_from_session_high'] = ((session_high - price) / session_high) * 100 if session_high > 0 else 0
            features['percent_from_session_low'] = ((price - session_low) / session_low) * 100 if session_low > 0 else 0
            features['cumulative_session_delta'] = (session_data['Close'] - session_data['Open']).sum()
            features['position_in_session_range'] = (price - session_low) / (session_high - session_low) if session_high > session_low else 0.5
        else:
            features['bars_since_session_high'] = 0
            features['bars_since_session_low'] = 0
            features['percent_from_session_high'] = 0
            features['percent_from_session_low'] = 0
            features['cumulative_session_delta'] = 0
            features['position_in_session_range'] = 0.5

        # PROPERLY CALCULATE Daily features
        yesterday = (entry_time - timedelta(days=1)).date()
        yesterday_data = available_candles[available_candles.index.date == yesterday]

        if len(yesterday_data) > 0:
            features['previous_day_range'] = float(yesterday_data['High'].max() - yesterday_data['Low'].min())

            # Calculate overnight gap
            yesterday_close = yesterday_data['Close'].iloc[-1]
            today_data = available_candles[available_candles.index.date == entry_time.date()]
            if len(today_data) > 0:
                today_open = today_data['Open'].iloc[0]
                features['overnight_gap_percent'] = ((today_open - yesterday_close) / yesterday_close) * 100 if yesterday_close != 0 else 0
            else:
                features['overnight_gap_percent'] = 0
        else:
            features['previous_day_range'] = 0
            features['overnight_gap_percent'] = 0

        # PROPERLY CALCULATE Weekly features
        if len(available_candles) >= ML_CONFIG['weekly_lookback_bars']:
            weekly_data = available_candles.tail(ML_CONFIG['weekly_lookback_bars'])
            weekly_high = weekly_data['High'].max()
            weekly_low = weekly_data['Low'].min()
            if weekly_high > weekly_low:
                features['position_in_5day_range'] = (price - weekly_low) / (weekly_high - weekly_low)
            else:
                features['position_in_5day_range'] = 0.5
        else:
            features['position_in_5day_range'] = 0.5

        # Momentum features
        if 'RSI' in df.columns and len(df) > 5:
            features['rsi_rate_of_change'] = (df['RSI'].iloc[-1] - df['RSI'].iloc[-6]) / 5
        else:
            features['rsi_rate_of_change'] = 0

        if 'MACD' in df.columns and len(df) > 2:
            macd_velocity = df['MACD'].diff()
            macd_acceleration = macd_velocity.diff()
            features['macd_acceleration'] = float(macd_acceleration.iloc[-1]) if not pd.isna(macd_acceleration.iloc[-1]) else 0
        else:
            features['macd_acceleration'] = 0

        if 'ATR' in df.columns and len(df) > 5:
            current_atr = df['ATR'].iloc[-1]
            past_atr = df['ATR'].iloc[-6]
            features['atr_rate_of_change'] = (current_atr - past_atr) / past_atr if past_atr > 0 else 0
        else:
            features['atr_rate_of_change'] = 0

        if len(df) > 3:
            recent_vol = df['Volume'].iloc[-1]
            avg_vol_3bars = df['Volume'].iloc[-4:-1].mean()
            features['volume_acceleration'] = (recent_vol - avg_vol_3bars) / (avg_vol_3bars + 1)
        else:
            features['volume_acceleration'] = 0

        # Price action features
        bar_range = latest['High'] - latest['Low']
        if bar_range > 0:
            features['wick_ratio_upper'] = (latest['High'] - latest['Close']) / bar_range
            features['wick_ratio_lower'] = (latest['Open'] - latest['Low']) / bar_range
        else:
            features['wick_ratio_upper'] = 0
            features['wick_ratio_lower'] = 0

        # Consecutive bars
        consecutive_green = 0
        consecutive_red = 0
        for i in range(len(df)-1, -1, -1):
            if df['Close'].iloc[i] > df['Open'].iloc[i]:
                if consecutive_red > 0:
                    break
                consecutive_green += 1
            else:
                if consecutive_green > 0:
                    break
                consecutive_red += 1

        features['consecutive_green_bars'] = consecutive_green
        features['consecutive_red_bars'] = consecutive_red

        # VWAP rejection
        vwap = (df['Close'] * df['Volume']).sum() / df['Volume'].sum() if df['Volume'].sum() > 0 else latest['Close']
        touch_distance = abs(latest['High'] - vwap) if latest['High'] > vwap else abs(latest['Low'] - vwap)
        atr_value = latest.get('ATR', 1) if 'ATR' in df.columns else 1
        features['rejection_from_vwap'] = 1 if touch_distance < atr_value * 0.2 else 0

        # PROPERLY CALCULATED Session context features from session_stats
        features['trades_today_count'] = session_stats['trades_today']
        features['session_pnl_cumulative'] = session_stats['session_pnl']
        features['win_rate_last_20_trades'] = session_stats['win_rate_last_20']
        features['bars_since_last_trade'] = session_stats['bars_since_last_trade']
        features['consecutive_wins'] = session_stats['consecutive_wins']
        features['consecutive_losses'] = session_stats['consecutive_losses']

        # News features
        news_events = get_economic_events_for_date(entry_time.date())
        features['is_news_day'] = 1 if news_events else 0
        features['news_count'] = len(news_events)
        features['has_extreme_news'] = 1 if any(e['impact'] == 'extreme' for e in news_events) else 0
        features['has_high_news'] = 1 if any(e['impact'] == 'high' for e in news_events) else 0
        features['has_medium_news'] = 1 if any(e['impact'] == 'medium' for e in news_events) else 0
        features['has_fomc'] = 1 if any(e['type'] == 'FOMC' for e in news_events) else 0
        features['has_nfp'] = 1 if any(e['type'] == 'NFP' for e in news_events) else 0
        features['has_cpi'] = 1 if any(e['type'] == 'CPI' for e in news_events) else 0
        features['has_ppi'] = 1 if any(e['type'] == 'PPI' for e in news_events) else 0
        features['has_gdp'] = 1 if any(e['type'] == 'GDP' for e in news_events) else 0
        features['has_retail_sales'] = 1 if any(e['type'] == 'RETAIL_SALES' for e in news_events) else 0

        # Time segment features
        segment_id, _ = get_current_time_segment(entry_time)
        for sid in TIME_SEGMENTS.keys():
            features[f'segment_{sid}'] = 1 if sid == segment_id else 0

        # News impact features
        news_impact = get_news_impact_for_date(entry_time.date())
        for impact in NEWS_IMPACT_LEVELS.keys():
            features[f'impact_{impact}'] = 1 if impact == news_impact else 0

        return features

    def add_completed_trade(self, trade):
        """Add a completed trade with features"""
        self.training_data.append(trade)

    def retrain(self):
        """Retrain model on accumulated trades"""
        if len(self.training_data) < 300:
            return False

        try:
            X = []
            y = []

            for trade in self.training_data[-15000:]:
                if 'features' in trade and trade['features'] and 'outcome' in trade:
                    features = trade['features']

                    if trade.get('was_reversed', False):
                        label = 1 if trade['outcome'] == 'success' else 0
                    else:
                        label = 0 if trade['outcome'] == 'success' else 1

                    if not self.feature_columns:
                        self.feature_columns = sorted(features.keys())

                    feature_list = [features.get(k, 0) for k in self.feature_columns]
                    X.append(feature_list)
                    y.append(label)

            if len(X) < 100:
                return False

            X = np.array(X)
            y = np.array(y)

            X_scaled = self.scaler.fit_transform(X)

            self.model = {
                'rf': RandomForestClassifier(n_estimators=100, max_depth=10, random_state=42),
                'gb': GradientBoostingClassifier(n_estimators=50, max_depth=5, random_state=42)
            }

            self.model['rf'].fit(X_scaled, y)
            self.model['gb'].fit(X_scaled, y)

            logger.info(f"✅ Model retrained on {len(X)} trades")
            return True

        except Exception as e:
            logger.error(f"Error training model: {e}")
            return False

    def predict_reversal(self, features):
        """Predict if signal should be reversed"""
        if not self.model or not features:
            return False, 0.5

        try:
            feature_list = [features.get(k, 0) for k in self.feature_columns]
            features_scaled = self.scaler.transform([feature_list])

            rf_prob = self.model['rf'].predict_proba(features_scaled)[0]
            gb_prob = self.model['gb'].predict_proba(features_scaled)[0]

            ensemble_prob = (rf_prob[1] + gb_prob[1]) / 2

            should_reverse = ensemble_prob > self.confidence_threshold

            return should_reverse, ensemble_prob

        except Exception as e:
            logger.error(f"Error predicting: {e}")
            return False, 0.5


# === SESSION TRACKER CLASS ===
class SessionTracker:
    """Track session statistics for feature calculation"""

    def __init__(self):
        self.trades_today = []
        self.all_trades = deque(maxlen=20)  # Last 20 trades
        self.session_pnl = 0
        self.consecutive_wins = 0
        self.consecutive_losses = 0
        self.last_trade_time = None
        self.current_date = None

    def reset_daily_stats(self):
        """Reset daily statistics"""
        self.trades_today = []
        self.session_pnl = 0
        self.consecutive_wins = 0
        self.consecutive_losses = 0

    def update_on_new_day(self, date):
        """Check if new day and reset if needed"""
        if self.current_date != date:
            self.reset_daily_stats()
            self.current_date = date

    def add_trade_result(self, trade_result, timestamp):
        """Add a completed trade result"""
        self.trades_today.append(trade_result)
        self.all_trades.append(trade_result)
        self.last_trade_time = timestamp

        # Update session PnL
        self.session_pnl += trade_result['pnl_points']

        # Update consecutive wins/losses
        if trade_result['pnl_points'] > 0:
            self.consecutive_wins += 1
            self.consecutive_losses = 0
        else:
            self.consecutive_losses += 1
            self.consecutive_wins = 0

    def get_stats(self, current_time):
        """Get current session statistics"""
        stats = {
            'trades_today': len(self.trades_today),
            'session_pnl': self.session_pnl,
            'consecutive_wins': self.consecutive_wins,
            'consecutive_losses': self.consecutive_losses,
            'bars_since_last_trade': 1440,  # Default
            'win_rate_last_20': 0.5  # Default
        }

        # Calculate bars since last trade
        if self.last_trade_time:
            minutes_diff = (current_time - self.last_trade_time).total_seconds() / 60
            stats['bars_since_last_trade'] = int(minutes_diff)

        # Calculate win rate for last 20 trades
        if len(self.all_trades) > 0:
            wins = sum(1 for t in self.all_trades if t['pnl_points'] > 0)
            stats['win_rate_last_20'] = wins / len(self.all_trades)

        return stats


